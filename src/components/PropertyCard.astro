---
import { formatPrice, statusLabel } from "@/lib/utils";
import { urlFor } from "@/lib/sanity";

interface Props {
  property: {
    slug: string;
    title: string;
    status: string;
    propertyType?: string;
    price: number;
    priceQualifier?: string;
    bedrooms?: number;
    bathrooms?: number;
    sqft?: number;
    town?: string;
    postcode?: string;
    featured?: boolean;
    thumbnail?: {
      asset: { url: string; metadata?: { lqip?: string } };
      alt?: string;
    };
    /** Optional listing agent — when present, render the avatar badge on the photo. */
    agent?: {
      name: string;
      slug?: string;
      photo?: unknown;
    };
  };
}

const { property } = Astro.props;
const {
  slug,
  title,
  status,
  price,
  priceQualifier,
  bedrooms,
  bathrooms,
  sqft,
  town,
  postcode,
  featured,
  thumbnail,
  agent,
} = property;

const imageUrl = thumbnail?.asset?.url
  ? `${thumbnail.asset.url}?w=600&h=450&fit=crop&auto=format`
  : "/floorplan-placeholder.svg";
const lqip = thumbnail?.asset?.metadata?.lqip;

const statusClass =
  status === "for-sale" || status === "sold-stc" || status === "under-offer"
    ? "badge pill-status-sale"
    : status === "for-rent" || status === "let-agreed" || status === "let"
      ? "badge pill-status-rent"
      : "badge pill-status-muted";

// Listing-agent avatar badge — uses Sanity urlFor when a photo is present,
// otherwise falls back to the agent's initials in a coloured disc.
const agentPhotoUrl = agent?.photo
  ? urlFor(agent.photo).width(80).height(80).fit("crop").auto("format").url()
  : null;
const agentInitials = agent?.name
  ? agent.name.split(" ").map((n) => n[0]).join("").slice(0, 2)
  : "";
---

<a
  href={`/properties/${slug}`}
  class="card property-card block"
  aria-label={title}
>
  <div class="property-image luxury-property-image">
    <img
      src={imageUrl}
      alt={thumbnail?.alt || title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover"
      style={lqip ? `background-image: url(${lqip}); background-size: cover;` : ""}
    />

    <div class="card-pills card-pills-tl">
      <span class:list={["badge", statusClass]}>
        {statusLabel(status)}
      </span>
      {featured && (
        <span class="badge pill-featured">Featured</span>
      )}
    </div>

    <button
      type="button"
      class="card-save"
      aria-label={`Save ${title} to shortlist`}
      data-save
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M12 21s-7.5-4.6-9.6-9.2C1 8.4 3 5 6.4 5c1.9 0 3.4 1 4.6 2.4C12.2 6 13.7 5 15.6 5 19 5 21 8.4 19.6 11.8 17.5 16.4 12 21 12 21z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    {agent && (
      <div class="card-avatar" aria-label={`Listed by ${agent.name}`}>
        {agentPhotoUrl ? (
          <img src={agentPhotoUrl} alt={agent.name} loading="lazy" />
        ) : (
          <span class="card-avatar-initials">{agentInitials}</span>
        )}
      </div>
    )}
  </div>

  <div class="card-body">
    <p class="text-price-lg mb-1.5">
      {formatPrice(price, priceQualifier)}
    </p>

    <h3 class="text-card-title text-text-primary mb-1.5 line-clamp-1">
      {title}
    </h3>

    {(town || postcode) && (
      <p class="text-meta mb-3" style="font-size: 12px; color: var(--color-text-muted);">
        {[town, postcode].filter(Boolean).join(", ")}
      </p>
    )}

    <div class="flex items-center gap-4 text-meta border-t pt-3" style="font-size: 12px; color: var(--color-text-muted); border-color: var(--color-border-subtle);">
      {bedrooms != null && (
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4" />
          </svg>
          {bedrooms} bed
        </span>
      )}
      {bathrooms != null && (
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M4 16h16M4 16V8a4 4 0 014-4h1" />
          </svg>
          {bathrooms} bath
        </span>
      )}
      {sqft != null && (
        <span>{sqft.toLocaleString("en-GB")} sq ft</span>
      )}
    </div>
  </div>
</a>
