---
import { formatPrice } from "@/lib/utils";

interface Props {
  siteName: string;
  tagline?: string;
  /** Featured property to highlight as a small overlay on the photo. */
  featured?: {
    bedrooms?: number;
    bathrooms?: number;
    sqft?: number;
    price: number;
    priceQualifier?: string;
    title: string;
    slug: string;
    thumbnail?: { asset: { url: string } };
  };
  /** Background image URL for the right-hand photo. Falls back to a navy gradient. */
  backgroundImage?: string;
}

// siteName is part of the public Props shape (back-compat with callers
// that pass it) but isn't used in the hero layout itself, so we drop it
// from the destructure.
const { tagline, featured, backgroundImage } = Astro.props;

const heroImg = backgroundImage || "/estate-demo-hero.webp";
---

<section class="hero" aria-label="Homepage hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <span class="hero-eyebrow">Sampletown · Established 2014</span>
      <h1>{tagline || "Refined property expertise for the Sampletown market."}</h1>
      <p class="hero-sub">
        A single named agent from your first viewing through to completion —
        accurate valuations, careful photography, and no scripts.
      </p>
      <div class="hero-cta-row">
        <a href="/valuation" class="btn btn-primary">Book a Valuation</a>
        <a href="/properties" class="btn btn-outline btn-outline-dark">Browse Listings</a>
      </div>
    </div>

    <div class="hero-image">
      <img
        src={heroImg}
        alt="An Estate Agent Demo agent greeting a client at the door of a Sampletown property"
        loading="eager"
        decoding="async"
      />
      {featured && (
        <a href={`/properties/${featured.slug}`} class="hero-featured">
          <span class="hero-featured-eyebrow">This week's featured</span>
          <span class="hero-featured-title">{featured.title}</span>
          <span class="hero-featured-price">
            {formatPrice(featured.price, featured.priceQualifier)}
          </span>
        </a>
      )}
    </div>
  </div>

  <!-- Floating search widget straddling the seam between the two columns -->
  <div class="hero-search-container">
    <div class="container">
      <form action="/properties" method="get" class="search-bar search-bar-luxury">
        <input
          type="text"
          name="q"
          class="sb-cell"
          placeholder="Enter location, postcode or keyword…"
          style="background-image: none; text-align: left;"
        />
        <select name="status" class="sb-cell" aria-label="Status">
          <option value="">Any Status</option>
          <option value="for-sale">For Sale</option>
          <option value="for-rent">To Let</option>
        </select>
        <select name="bedrooms" class="sb-cell" aria-label="Bedrooms">
          <option value="">Any Beds</option>
          <option value="1">1+</option>
          <option value="2">2+</option>
          <option value="3">3+</option>
          <option value="4">4+</option>
        </select>
        <select name="bathrooms" class="sb-cell" aria-label="Bathrooms">
          <option value="">Any Baths</option>
          <option value="1">1+</option>
          <option value="2">2+</option>
          <option value="3">3+</option>
        </select>
        <select name="maxPrice" class="sb-cell" aria-label="Max price">
          <option value="">Max Price</option>
          <option value="250000">Up to £250k</option>
          <option value="500000">Up to £500k</option>
          <option value="750000">Up to £750k</option>
          <option value="1000000">Up to £1m</option>
          <option value="2000000">Up to £2m</option>
        </select>
        <button type="submit" class="sb-submit">Search</button>
      </form>
    </div>
  </div>
</section>
