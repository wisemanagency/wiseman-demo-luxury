---
interface Props {
  siteName: string;
  tagline?: string;
  /** Background image URL for the right-hand photo. Falls back to a navy gradient. */
  backgroundImage?: string;
}

// siteName is part of the public Props shape (back-compat with callers
// that pass it) but isn't used in the hero layout itself, so we drop it
// from the destructure.
const { tagline, backgroundImage } = Astro.props;

const heroImg = backgroundImage || "/estate-demo-hero.webp";
---

<section class="hero" aria-label="Homepage hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <span class="hero-eyebrow">Sampletown · Established 2014</span>
      <h1>{tagline || "Refined property expertise for the Sampletown market."}</h1>
      <p class="hero-sub">
        A single named agent from your first viewing through to completion —
        accurate valuations, careful photography, and no scripts.
      </p>
      <div class="hero-cta-row">
        <a href="/valuation" class="btn btn-primary">Book a Valuation</a>
        <a href="/properties" class="btn btn-outline btn-outline-dark">Browse Listings</a>
      </div>
    </div>

    <div class="hero-image">
      <img
        src={heroImg}
        alt="An Estate Agent Demo agent greeting a client at the door of a Sampletown property"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <!-- Floating search card — left-anchored, straddling the hero seam on
       desktop; stacks normally below the hero copy on tablet/mobile.
       The Sales / Rentals tabs sit ABOVE the white search card on the
       powder-teal hero background. The active tab is a FULL solid
       brand-cyan block (no white inside, green flush to the top of
       the search area); the inactive tab is white. The two tabs'
       outer edges carry a small top-corner radius so the active tab
       reads as a continuous block with the search card below. The
       tabs row and card read as one unified search bar. -->
  <div class="hero-search-container">
    <div class="hero-search-tabs" role="tablist" aria-label="Property status">
      <button
        type="button"
        class="hero-search-tab is-active"
        data-status="for-sale"
        role="tab"
        aria-selected="true"
      >
        Sales
      </button>
      <button
        type="button"
        class="hero-search-tab"
        data-status="for-rent"
        role="tab"
        aria-selected="false"
      >
        Rentals
      </button>
    </div>
    <div class="hero-search-card">
      <form action="/properties" method="get" class="search-bar">
        <input type="hidden" name="status" value="for-sale" data-status-input />
        <input
          type="text"
          name="q"
          class="sb-cell"
          placeholder="Enter location, postcode or keyword…"
          style="background-image: none; text-align: left;"
        />
        <select name="bedrooms" class="sb-cell" aria-label="Bedrooms">
          <option value="">Any Beds</option>
          <option value="1">1+</option>
          <option value="2">2+</option>
          <option value="3">3+</option>
          <option value="4">4+</option>
        </select>
        <select name="bathrooms" class="sb-cell" aria-label="Bathrooms">
          <option value="">Any Baths</option>
          <option value="1">1+</option>
          <option value="2">2+</option>
          <option value="3">3+</option>
        </select>
        <select name="maxPrice" class="sb-cell" aria-label="Max price">
          <option value="">Max Price</option>
          <option value="250000">Up to £250k</option>
          <option value="500000">Up to £500k</option>
          <option value="750000">Up to £750k</option>
          <option value="1000000">Up to £1m</option>
          <option value="2000000">Up to £2m</option>
        </select>
        <button type="submit" class="sb-submit">Search</button>
      </form>
    </div>
  </div>

  <script is:inline>
    // Sync the active pill -> the hidden status input + ARIA selected state.
    (() => {
      const tabs = document.querySelectorAll(".hero-search-tab");
      const input = document.querySelector("[data-status-input]");
      if (!tabs.length || !input) return;
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => {
            t.classList.remove("is-active");
            t.setAttribute("aria-selected", "false");
          });
          tab.classList.add("is-active");
          tab.setAttribute("aria-selected", "true");
          input.value = tab.getAttribute("data-status") || "for-sale";
        });
      });
    })();
  </script>
</section>
