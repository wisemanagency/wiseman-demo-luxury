---
/**
 * Footer CTA band — used at the bottom of the homepage and about page.
 * Powder-teal background, serif heading, gold divider, two-column layout
 * (photo + copy). Mirrors the sales demo's footer CTA but reskinned for
 * the luxury palette.
 */
import SectionDivider from "@/components/SectionDivider.astro";

interface Props {
  /** Image to the left of the copy. Defaults to the office exterior asset. */
  image?: string;
  imageAlt?: string;
  /** Eyebrow text above the heading. */
  eyebrow?: string;
  /** Main heading. */
  heading?: string;
  /** Supporting paragraph. */
  description?: string;
  /** Checklist bullets (one per item). */
  bullets?: string[];
  /** CTA button label. */
  ctaLabel?: string;
  ctaHref?: string;
  /** Optional trust badge — "rating · reviews" string. */
  trustRating?: string;
  trustMeta?: string;
}

const {
  image = "/estate-office-outdoor.webp",
  imageAlt = "Estate agent office exterior with sold sign",
  eyebrow = "Free property valuation",
  heading = "Thinking of Selling?",
  description = "Get a free, no-obligation valuation from our local experts. We'll give you an honest appraisal of your property's worth — usually within 48 hours.",
  bullets = ["Free valuation", "No obligation", "Local expert", "Honest appraisal"],
  ctaLabel = "Book a Free Valuation",
  ctaHref = "/valuation",
  trustRating = "4.9",
  trustMeta = "200+ Google reviews",
} = Astro.props;
---

<section class="section cta-strip cta-strip-rich">
  <div class="container cta-strip-grid">
    <div class="cta-strip-image">
      <img
        src={image}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="cta-strip-copy">
      <SectionDivider width={64} />
      <span class="cta-strip-eyebrow">{eyebrow}</span>
      <h2>{heading}</h2>
      <p class="cta-strip-sub">{description}</p>

      <ul class="cta-checklist">
        {bullets.map((b) => (
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6L9 17l-5-5" />
            </svg>
            <span>{b}</span>
          </li>
        ))}
      </ul>

      <a href={ctaHref} class="btn btn-primary cta-strip-btn">
        {ctaLabel}
      </a>

      <div class="cta-trust">
        <span class="cta-trust-stars" aria-label={`Rated ${trustRating} out of 5`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#c9a227" aria-hidden="true"><path d="M12 2.5l2.95 6 6.6.96-4.78 4.66 1.13 6.58L12 17.6l-5.9 3.1 1.13-6.58L2.45 9.46l6.6-.96L12 2.5z" /></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#c9a227" aria-hidden="true"><path d="M12 2.5l2.95 6 6.6.96-4.78 4.66 1.13 6.58L12 17.6l-5.9 3.1 1.13-6.58L2.45 9.46l6.6-.96L12 2.5z" /></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#c9a227" aria-hidden="true"><path d="M12 2.5l2.95 6 6.6.96-4.78 4.66 1.13 6.58L12 17.6l-5.9 3.1 1.13-6.58L2.45 9.46l6.6-.96L12 2.5z" /></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#c9a227" aria-hidden="true"><path d="M12 2.5l2.95 6 6.6.96-4.78 4.66 1.13 6.58L12 17.6l-5.9 3.1 1.13-6.58L2.45 9.46l6.6-.96L12 2.5z" /></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#c9a227" aria-hidden="true"><path d="M12 2.5l2.95 6 6.6.96-4.78 4.66 1.13 6.58L12 17.6l-5.9 3.1 1.13-6.58L2.45 9.46l6.6-.96L12 2.5z" /></svg>
        </span>
        <span class="cta-trust-meta">
          <strong>{trustRating}</strong> · {trustMeta}
        </span>
      </div>
    </div>
  </div>
</section>
